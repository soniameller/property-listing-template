# Contentful CMS
CONTENTFUL_SPACE_ID=your_space_id
CONTENTFUL_ACCESS_TOKEN=your_delivery_api_token

# Optional: specific property slug if you have multiple entries
# PROPERTY_SLUG=demo-coastal-house

# Cloudflare Web Analytics (omit locally if you don't want to track dev visits)
# Token from Cloudflare Dashboard → Analytics & logs → Web Analytics
PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=your_beacon_token
