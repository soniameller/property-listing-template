---
import Layout from '../layouts/Layout.astro';
import type { Locale } from '../i18n/config';
import { t } from '../i18n/ui';
import { localizedPath } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const homePath = localizedPath(locale);
---

<Layout title={t(locale, 'thanks.pageTitle')} locale={locale}>
  <main class="flex min-h-screen items-center justify-center px-4">
    <div class="max-w-md rounded-3xl border border-stone-200 bg-white p-8 text-center shadow-sm">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-accent">
        {t(locale, 'thanks.eyebrow')}
      </p>
      <h1 class="mt-2 font-serif text-3xl font-bold text-stone-900">
        {t(locale, 'thanks.title')}
      </h1>
      <p class="mt-3 text-stone-600">
        {t(locale, 'thanks.body')}
      </p>
      <a
        href={homePath}
        class="mt-6 inline-flex rounded-full bg-accent px-6 py-3 text-sm font-semibold text-white transition hover:bg-accent-dark"
      >
        {t(locale, 'thanks.back')}
      </a>
    </div>
  </main>
</Layout>
