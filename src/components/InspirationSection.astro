---
import type { Locale } from '../i18n/config';
import { t } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const concepts = [
  {
    src: '/inspiration/inspiration-living-room.svg',
    title: t(locale, 'inspiration.livingRoom'),
    alt: t(locale, 'inspiration.livingRoomAlt'),
  },
  {
    src: '/inspiration/inspiration-bedroom.svg',
    title: t(locale, 'inspiration.bedroom'),
    alt: t(locale, 'inspiration.bedroomAlt'),
  },
  {
    src: '/inspiration/inspiration-patio.svg',
    title: t(locale, 'inspiration.patio'),
    alt: t(locale, 'inspiration.patioAlt'),
  },
  {
    src: '/inspiration/inspiration-bedroom-office.svg',
    title: t(locale, 'inspiration.bedroomOffice'),
    alt: t(locale, 'inspiration.bedroomOfficeAlt'),
  },
  {
    src: '/inspiration/inspiration-guest-bedroom.svg',
    title: t(locale, 'inspiration.guestBedroom'),
    alt: t(locale, 'inspiration.guestBedroomAlt'),
  },
  {
    src: '/inspiration/inspiration-attic-studio.svg',
    title: t(locale, 'inspiration.atticStudio'),
    alt: t(locale, 'inspiration.atticStudioAlt'),
  },
];
---

<section
  id="inspiration"
  class="scroll-mt-24 border-b border-stone-200 bg-stone-50"
  aria-labelledby="inspiration-title"
>
  <details id="inspiration-details" class="group" open>
    <summary
      class="cursor-pointer list-none bg-accent marker:content-none focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-white"
    >
      <span
        class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-4 py-7 sm:px-6 lg:px-8"
      >
        <span class="flex items-center gap-3 sm:gap-4">
          <img
            src={concepts[0].src}
            alt=""
            class="size-14 shrink-0 rounded-lg object-cover ring-1 ring-white/30 sm:size-16"
            loading="lazy"
            width="64"
            height="64"
          />
          <span>
            <span
              id="inspiration-title"
              class="block font-serif text-2xl font-semibold text-white"
            >
              {t(locale, 'inspiration.title')}
            </span>
            <span class="mt-1 block text-sm text-stone-200 sm:text-base">
              {t(locale, 'inspiration.summary')}
            </span>
          </span>
        </span>
        <span
          class="flex shrink-0 items-center gap-2 text-sm font-medium text-white sm:gap-3"
        >
          <span class="group-open:hidden">{t(locale, 'inspiration.seeImages')}</span>
          <span class="hidden group-open:inline">{t(locale, 'inspiration.hideImages')}</span>
          <span
            class="flex size-9 items-center justify-center rounded-full border border-white/30 bg-white/10 transition"
            aria-hidden="true"
          >
            <svg
              viewBox="0 0 24 24"
              class="size-5 transition-transform group-open:rotate-180"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
            >
              <path d="m6 9 6 6 6-6"></path>
            </svg>
          </span>
        </span>
      </span>
    </summary>

    <div class="mx-auto max-w-7xl px-4 pb-10 sm:px-6 lg:px-8">
      <div class="border-t border-stone-200 pt-7">
        <p class="max-w-2xl text-stone-600">
          {t(locale, 'inspiration.intro')}
        </p>

        <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {
            concepts.map((concept) => (
              <figure class="overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-stone-200">
                <img
                  src={concept.src}
                  alt={concept.alt}
                  class="aspect-[3/4] w-full object-cover"
                  loading="lazy"
                  width="768"
                  height="1024"
                />
                <figcaption class="px-4 py-3 text-sm font-medium text-stone-800">
                  {concept.title}
                </figcaption>
              </figure>
            ))
          }
        </div>

        <p class="mt-5 text-xs leading-relaxed text-stone-500">
          {t(locale, 'inspiration.disclaimer')}
        </p>
      </div>
    </div>
  </details>
</section>
