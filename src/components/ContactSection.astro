---
import type { Locale } from '../i18n/config';
import { t } from '../i18n/ui';
import { localizedPath } from '../i18n/utils';
import type { Property } from '../lib/types';
import { getWhatsAppLink } from '../lib/format';

interface Props {
  property: Property;
  locale: Locale;
}

const { property, locale } = Astro.props;

const whatsappMessage = t(locale, 'contact.whatsappMessage', {
  title: property.title,
  city: property.city,
});
const whatsappLink = getWhatsAppLink(property.whatsappNumber, whatsappMessage);
const thanksPath = localizedPath(locale, 'thanks');
const sendLabel = t(locale, 'contact.send');
const sendingLabel = t(locale, 'contact.sending');
const defaultMessage = t(locale, 'contact.defaultMessage', {
  title: property.title,
});
---

<section id="contact" class="scroll-mt-24 bg-stone-100 py-12">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-8 lg:grid-cols-2">
      <div>
        <h2 class="font-serif text-3xl font-semibold text-stone-900">
          {t(locale, 'contact.title')}
        </h2>
        {
          property.showWhatsApp ? (
            <>
              <p class="mt-3 max-w-lg text-stone-600">
                {t(locale, 'contact.whatsappIntro')}
              </p>

              <a
                href={whatsappLink}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-6 inline-flex items-center gap-3 rounded-full bg-[#25D366] px-6 py-3 text-sm font-semibold text-white transition hover:bg-[#1ebe57] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#25D366]"
              >
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                </svg>
                {t(locale, 'contact.whatsappCta')}
              </a>
            </>
          ) : (
            <p class="mt-3 max-w-lg text-stone-600">
              {t(locale, 'contact.formIntro')}
            </p>
          )
        }

        {
          property.contactEmail && (
            <p class="mt-4 text-sm text-stone-600">
              {t(locale, 'contact.alsoEmail')}{' '}
              <a
                href={`mailto:${property.contactEmail}`}
                class="font-medium text-accent underline-offset-2 hover:underline"
              >
                {property.contactEmail}
              </a>
            </p>
          )
        }
      </div>

      {
        property.showContactForm && (
          <div class="rounded-3xl border border-stone-200 bg-white p-6 shadow-sm">
            <h3 class="text-lg font-semibold text-stone-900">
              {t(locale, 'contact.formTitle')}
            </h3>
            <p class="mt-1 text-sm text-stone-600">
              {t(locale, 'contact.formHelp')}
            </p>

            <form
              id="contact-form"
              name="contact"
              method="POST"
              action={thanksPath}
              data-netlify="true"
              data-contact-email={property.contactEmail ?? ''}
              data-thanks-path={thanksPath}
              netlify-honeypot="bot-field"
              class="mt-6 space-y-4"
            >
              <input type="hidden" name="form-name" value="contact" />
              <p class="hidden">
                <label>
                  {t(locale, 'contact.honeypot')} <input name="bot-field" />
                </label>
              </p>
              <input type="hidden" name="property" value={property.title} />
              <input type="hidden" name="locale" value={locale} />

              <div>
                <label for="name" class="mb-1 block text-sm font-medium text-stone-700">
                  {t(locale, 'contact.name')}{' '}
                  <span class="text-accent" aria-hidden="true">*</span>
                </label>
                <input
                  id="name"
                  name="name"
                  type="text"
                  required
                  autocomplete="name"
                  class="w-full rounded-xl border border-stone-300 px-4 py-3 text-stone-900 outline-none transition focus:border-accent focus:ring-2 focus:ring-accent/20"
                />
              </div>

              <div>
                <label for="email" class="mb-1 block text-sm font-medium text-stone-700">
                  {t(locale, 'contact.email')}{' '}
                  <span class="text-accent" aria-hidden="true">*</span>
                </label>
                <input
                  id="email"
                  name="email"
                  type="email"
                  required
                  autocomplete="email"
                  class="w-full rounded-xl border border-stone-300 px-4 py-3 text-stone-900 outline-none transition focus:border-accent focus:ring-2 focus:ring-accent/20"
                />
              </div>

              <div>
                <label for="phone" class="mb-1 block text-sm font-medium text-stone-700">
                  {t(locale, 'contact.phone')}
                </label>
                <input
                  id="phone"
                  name="phone"
                  type="tel"
                  autocomplete="tel"
                  class="w-full rounded-xl border border-stone-300 px-4 py-3 text-stone-900 outline-none transition focus:border-accent focus:ring-2 focus:ring-accent/20"
                />
              </div>

              <div>
                <label for="message" class="mb-1 block text-sm font-medium text-stone-700">
                  {t(locale, 'contact.message')}{' '}
                  <span class="text-accent" aria-hidden="true">*</span>
                </label>
                <textarea
                  id="message"
                  name="message"
                  rows="4"
                  required
                  class="w-full rounded-xl border border-stone-300 px-4 py-3 text-stone-900 outline-none transition focus:border-accent focus:ring-2 focus:ring-accent/20"
                >{defaultMessage}</textarea>
              </div>

              <div
                id="contact-form-error"
                role="alert"
                tabindex="-1"
                hidden
                class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800"
              >
                <p id="contact-form-error-message">
                  {t(locale, 'contact.error')}
                </p>
                {
                  property.contactEmail && (
                    <p class="mt-1">
                      {t(locale, 'contact.alsoEmail')}{' '}
                      <a
                        href={`mailto:${property.contactEmail}`}
                        class="font-medium underline underline-offset-2"
                      >
                        {t(locale, 'contact.emailFallback')}
                      </a>
                      .
                    </p>
                  )
                }
              </div>

              <button
                type="submit"
                id="contact-submit"
                class="w-full rounded-full bg-accent px-5 py-3 text-sm font-semibold text-white transition hover:bg-accent-dark disabled:cursor-not-allowed disabled:opacity-70"
              >
                <span id="contact-submit-label" class="inline-flex items-center justify-center gap-2">
                  <span id="contact-submit-text">{sendLabel}</span>
                  <svg
                    id="contact-submit-spinner"
                    class="hidden h-4 w-4 animate-spin"
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <circle
                      class="opacity-25"
                      cx="12"
                      cy="12"
                      r="10"
                      stroke="currentColor"
                      stroke-width="4"
                    />
                    <path
                      class="opacity-75"
                      fill="currentColor"
                      d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
                    />
                  </svg>
                </span>
              </button>
            </form>
          </div>
        )
      }
    </div>
  </div>
</section>

<script define:vars={{ sendLabel, sendingLabel, thanksPath }}>
  const form = document.getElementById('contact-form');
  const submitButton = document.getElementById('contact-submit');
  const submitText = document.getElementById('contact-submit-text');
  const submitSpinner = document.getElementById('contact-submit-spinner');
  const errorAlert = document.getElementById('contact-form-error');

  function setSubmitting(isSubmitting) {
    if (!form || !submitButton || !submitText || !submitSpinner) return;

    submitButton.disabled = isSubmitting;
    form.toggleAttribute('aria-busy', isSubmitting);
    submitText.textContent = isSubmitting ? sendingLabel : sendLabel;
    submitSpinner.classList.toggle('hidden', !isSubmitting);
  }

  function hideError() {
    if (!errorAlert) return;
    errorAlert.hidden = true;
  }

  function showError() {
    if (!errorAlert) return;
    errorAlert.hidden = false;
    errorAlert.focus();
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();

    if (!form) return;

    hideError();
    setSubmitting(true);

    try {
      const formData = new FormData(form);
      const response = await fetch('/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams(formData).toString(),
      });

      if (!response.ok) {
        throw new Error('Form submission failed');
      }

      window.location.href = thanksPath;
    } catch {
      showError();
      setSubmitting(false);
    }
  });
</script>
